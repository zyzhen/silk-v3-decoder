// silk_dll.rc -- silkcodec.dll version resource (ASCII only to stay
// independent of the resource compiler's default code page).

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "silk2mp3 contributors"
            VALUE "FileDescription",  "SILK v3 audio codec dynamic library (decode/encode wechat amr, aud and qq slk voice files)"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "silkcodec"
            VALUE "LegalCopyright",   "SILK SDK Copyright (c) 2006-2012 Skype Limited. Wrapper under MIT License."
            VALUE "OriginalFilename", "silkcodec.dll"
            VALUE "ProductName",      "silk2mp3 windows-dll"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
